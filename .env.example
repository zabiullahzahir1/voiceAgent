# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of this service. Vapi calls back into it for tool execution.
# Local dev: your ngrok/cloudflared URL. Production: your Render URL.
PUBLIC_BASE_URL=https://your-app.onrender.com

# --- Database --------------------------------------------------------------
# Path to the SQLite file. On Render this points at the mounted persistent disk
# so records survive restarts and redeploys.
DATABASE_PATH=./data/patients.sqlite

# Insert two demo patients on boot if the table is empty (see src/db/seed.ts).
SEED_ON_BOOT=true

# --- Voice agent (Vapi) ----------------------------------------------------
# Private API key from https://dashboard.vapi.ai -> Organization -> API Keys.
# Only needed to run `npm run provision:vapi`; the running server does not use it.
VAPI_API_KEY=

# Shared secret Vapi sends back as the `x-vapi-secret` header on every webhook.
# The server rejects webhook calls that do not present it. Generate any random
# string, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
VAPI_SERVER_SECRET=

# The Vapi phone number ID to attach the assistant to (optional; the provisioning
# script will list your numbers and attach the first one if left blank).
VAPI_PHONE_NUMBER_ID=

# --- API auth --------------------------------------------------------------
# Optional bearer token for the write endpoints (POST/PUT/DELETE) and the
# dashboard. Leave blank to run the API fully open — fine for a demo, called out
# as a known limitation in the README.
API_TOKEN=
